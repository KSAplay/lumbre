# Puerto HTTP del backend (Express)
PORT=3000

# URI de MongoDB Atlas (o local). Incluye el nombre de la base antes del "?".
# Ejemplo Atlas:
# MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster.xxxxx.mongodb.net/lumbre?retryWrites=true&w=majority
MONGODB_URI=

# Secreto para firmar JWT del personal (cadena larga y aleatoria)
JWT_SECRET=
